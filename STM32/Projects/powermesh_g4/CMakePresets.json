{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake"
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "POWERMESH_ROLE": "ENDPOINT",
                "POWERMESH_TRANSPORT": "WIRED"
            }
        },
        {
            "name": "GatewayDebug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "POWERMESH_ROLE": "GATEWAY",
                "POWERMESH_TRANSPORT": "WIRED"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "POWERMESH_ROLE": "ENDPOINT",
                "POWERMESH_TRANSPORT": "WIRED"
            }
        },
        {
            "name": "EndpointPLC",
            "inherits": "Debug",
            "cacheVariables": {
                "POWERMESH_TRANSPORT": "ST8500"
            }
        },
        {
            "name": "GatewayPLC",
            "inherits": "GatewayDebug",
            "cacheVariables": {
                "POWERMESH_TRANSPORT": "ST8500"
            }
        },
        {
            "name": "PHYTx",
            "inherits": "GatewayPLC",
            "cacheVariables": {
                "POWERMESH_PHY_TEST": "TX"
            }
        },
        {
            "name": "PHYRx",
            "inherits": "EndpointPLC",
            "cacheVariables": {
                "POWERMESH_PHY_TEST": "RX"
            }
        },
        {
            "name": "GatewayJoin",
            "inherits": "GatewayPLC",
            "cacheVariables": {
                "POWERMESH_JOIN_ONLY": "ON"
            }
        },
        {
            "name": "EndpointJoin",
            "inherits": "EndpointPLC",
            "cacheVariables": {
                "POWERMESH_JOIN_ONLY": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "GatewayDebug",
            "configurePreset": "GatewayDebug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "EndpointPLC",
            "configurePreset": "EndpointPLC"
        },
        {
            "name": "GatewayPLC",
            "configurePreset": "GatewayPLC"
        },
        {
            "name": "PHYTx",
            "configurePreset": "PHYTx"
        },
        {
            "name": "PHYRx",
            "configurePreset": "PHYRx"
        },
        {
            "name": "GatewayJoin",
            "configurePreset": "GatewayJoin"
        },
        {
            "name": "EndpointJoin",
            "configurePreset": "EndpointJoin"
        }
    ]
}
