{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug G4 Endpoint",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/powermesh_g4.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "device": "STM32G474RE",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32g4x.cfg"
      ],
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw"
    },
    {
      "name": "Debug G4 Gateway",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/GatewayDebug/powermesh_g4.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "device": "STM32G474RE",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32g4x.cfg"
      ],
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw"
    },
    {
      "name": "Debug G4 Endpoint PLC",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/EndpointPLC/powermesh_g4.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "device": "STM32G474RE",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32g4x.cfg"
      ],
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw"
    }
  ]
}
